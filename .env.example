# Django
APP_NAME=Pakabet
DJANGO_SECRET_KEY=generate-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_ADMINS=
SECURITY_LOGIN_FAILURE_THRESHOLD=5
SECURITY_LOGIN_FAILURE_WINDOW_SECONDS=600
SECURITY_ALERT_COOLDOWN_SECONDS=900
SECURITY_LOGIN_ACCOUNT_LIMIT=10
SECURITY_LOGIN_IP_LIMIT=50
SECURITY_LOGIN_RATE_WINDOW_SECONDS=900
SECURITY_BET_ACCOUNT_LIMIT=30
SECURITY_BET_IP_LIMIT=90
SECURITY_CASHOUT_ACCOUNT_LIMIT=30
SECURITY_CASHOUT_IP_LIMIT=120
SECURITY_GAME_RATE_WINDOW_SECONDS=60
SECURITY_REGISTER_IP_LIMIT=5
SECURITY_REGISTER_WINDOW_SECONDS=3600
SECURITY_PAYMENT_ACCOUNT_LIMIT=8
SECURITY_PAYMENT_IP_LIMIT=20
SECURITY_PAYMENT_WINDOW_SECONDS=3600
SECURITY_ROOM_CREATE_ACCOUNT_LIMIT=5
SECURITY_ROOM_CREATE_IP_LIMIT=20
SECURITY_ROOM_CREATE_WINDOW_SECONDS=3600

# Database: leave DATABASE_URL blank to continue using local SQLite.
# For production PostgreSQL, set DATABASE_URL to the provider's private connection URL.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=600
SQLITE_DATABASE_PATH=

# Email (console backend is used locally when EMAIL_BACKEND is unset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Pakabet <no-reply@localhost>"

# Channels / Redis
DJANGO_USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# ioTec Pay (sandbox by default; fill credentials only in the local .env)
IOTEC_PAY_MODE=sandbox
IOTEC_PAY_API_BASE_URL=https://pay.iotec.io
IOTEC_PAY_TOKEN_URL=https://id.iotec.io/connect/token
IOTEC_PAY_CLIENT_ID=
IOTEC_PAY_CLIENT_SECRET=
IOTEC_PAY_WALLET_ID=
IOTEC_PAY_CURRENCY=UGX
IOTEC_PAY_CHANNEL=Api
IOTEC_PAY_CHARGE_CATEGORY=ChargeCustomer
IOTEC_PAY_TIMEOUT_SECONDS=20
# Required to authenticate provider callbacks; configure a unique secret before deployment.
IOTEC_PAY_CALLBACK_TOKEN=
